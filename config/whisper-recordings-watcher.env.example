# Local watcher configuration. The installer copies this file to
# ~/.config/whisper-recordings-watcher.env only when that file does not exist.

WATCH_DIR="/home/jakub-pelka/MobileTransfer/Recordings"

LANGUAGE="sv"
KB_MODEL="large"
KB_REVISION="standard"

# Used automatically when LANGUAGE is not Swedish.
WHISPER_MODEL="large-v3-turbo"
WHISPER_PRESET="fast"

# Create a professional service-note DOCX from the local transcript. Audio is
# never sent to the API. Keep the API key in a private file outside this repo.
GENERATE_MEETING_NOTE="true"
NOTE_LANGUAGE="sv"
NOTE_DRAFT_MODEL="gpt-5.6-luna"
NOTE_VERIFICATION_MODEL="gpt-5.6-terra"
NOTE_REASONING_EFFORT="medium"
OPENAI_ENV_FILE=""

# Keep raw transcription artifacts separate from professional notes.
TRANSCRIPT_DIR_NAME="output_transkrypcja"
NOTE_DIR_NAME="Notatki"
LOG_DIR_NAME="Logi"

# Abort a stalled audio conversion instead of blocking all later recordings.
FFMPEG_TIMEOUT_SECONDS="1800"

STABILITY_SECONDS="90"
SCAN_INTERVAL_SECONDS="120"

RECURSIVE_SCAN="false"
RETRY_FAILED="true"
RETRY_DELAY_SECONDS="3600"
